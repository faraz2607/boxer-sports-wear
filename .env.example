# Published Google Sheets CSV export URLs.
REACT_APP_CATALOG_CSV_URL=https://docs.google.com/spreadsheets/d/PASTE_CATALOG_SHEET_ID/export?format=csv&gid=0
REACT_APP_CAROUSEL_CSV_URL=https://docs.google.com/spreadsheets/d/PASTE_CAROUSEL_SHEET_ID/export?format=csv&gid=0

# Optional: default shop destination for product and header links.
REACT_APP_MEESHO_SHOP_URL=https://www.meesho.com/

# Admin portal credentials (local browser-only admin UI).
# Set unique values in .env.local and restart the app.
REACT_APP_ADMIN_PASSWORD=replace-with-a-long-unique-password
REACT_APP_ADMIN_SECRET_KEY=replace-with-a-different-long-random-secret
