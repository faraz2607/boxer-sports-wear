# Optional: URL of a Google Sheet published to the web as CSV.
# Copy to .env.local and replace the URL. Restart `npm start` after changing it.
REACT_APP_CATALOG_CSV_URL=https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/export?format=csv&gid=0
REACT_APP_CAROUSEL_CSV_URL=https://docs.google.com/spreadsheets/d/REPLACE_WITH_CAROUSEL_SHEET_ID/export?format=csv&gid=0

# Optional: Boxer Sports Wear Meesho shop destination.
REACT_APP_MEESHO_SHOP_URL=https://www.meesho.com/
